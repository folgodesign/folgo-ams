# Copy to .env and adjust.
#
# PostgreSQL connection string. For local dev, `docker compose up -d db`
# (from the repo root) starts one matching the URL below. In production
# (Railway), this is provided by the Postgres plugin — set
# DATABASE_URL=${{Postgres.DATABASE_URL}} in the service variables.
DATABASE_URL="postgresql://folgo:folgo@localhost:5432/folgo?schema=public"

PORT=4000
NODE_ENV=development

# Secrets — replace in any real deployment with long random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Access token lifetime (PRD F-1.4: 15 min). Refresh token: 30 days.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS origin for the web client in dev (Vite). In single-service production
# the frontend is same-origin, so this is only used as a safety default.
WEB_ORIGIN="http://localhost:5173"

# One-time bootstrap secret gating the super-admin setup wizard (PRD F-1.7).
# Set a strong value in production.
BOOTSTRAP_SECRET="folgo-bootstrap"

# Base URL used when composing invite/activation links. In production set this
# to your deployed URL, e.g. https://folgo-pulse.up.railway.app
APP_BASE_URL="http://localhost:5173"
