# Copy to .env and adjust. SQLite is used for self-contained dev/demo.
# For production, switch schema.prisma provider to "postgresql" and set a
# Postgres connection string here.
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Secrets — replace in any real deployment. Never commit real secrets.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Access token lifetime (PRD F-1.4: 15 min). Refresh token: 30 days.
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS origin for the web client (Vite dev server).
WEB_ORIGIN="http://localhost:5173"

# One-time bootstrap secret gating the super-admin setup wizard (PRD F-1.7).
BOOTSTRAP_SECRET="folgo-bootstrap"

# Base URL used when composing invite/activation links in emails.
APP_BASE_URL="http://localhost:5173"
